// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogImagesStatus {
  IN_USE
  NOT_IN_USE
}

model BlogImage {
  id       String           @id @default(cuid())
  userId   String
  publicId String
  url      String
  status   BlogImagesStatus @default(IN_USE)
  User     User             @relation(fields: [userId], references: [clerkId])

  @@map("blog_images")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum UserRole {
  READER
  WRITER
  EDITOR
  ADMIN
}

enum Subscription {
  FREE
  PRO
  ENTERPRISE
}

model User {
  clerkId      String       @unique
  username     String       @unique
  email        String       @unique
  password     String?
  image        String?
  bio String
  role         UserRole     @default(READER)
  subscribed   Boolean      @default(false) @map("subscribed")
  subscription Subscription @default(FREE) @map("subscription")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  posts      Post[]
  comments   Comment[]
  likes      Like[]
  blogImages BlogImage[]

  @@map("users")
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String
  content     String
  excerpt     String
  coverImage  String
  status      BlogStatus @default(DRAFT)
  authorId    String
  publishedAt DateTime

  author     User       @relation(fields: [authorId], references: [clerkId])
  categories Category[]
  tags       Tag[]
  comments   Comment[]
  likes      Like[]

  @@map("posts")
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String

  post Post[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  post Post[]

  @@map("tags")
}

model Comment {
  id       String  @id @default(cuid())
  content  String
  parentId String?

  postId String
  post   Post   @relation(fields: [postId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [clerkId])

  @@map("comments")
}

model Like {
  id     String @id @default(cuid())
  userId String
  postId String
   createdAt DateTime @default(now())

  post   Post   @relation(fields: [postId], references: [id])
  User   User   @relation(fields: [userId], references: [clerkId])

  @@unique([userId, postId])
  @@index([postId])

  @@map("likes")
}
