generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogImagesStatus {
  IN_USE
  NOT_IN_USE
}

model BlogImages {
  id       String           @id @default(cuid())
  userId   Int
  publicId String
  url      String
  status   BlogImagesStatus @default(IN_USE)

  @@map("blog_images")
}
