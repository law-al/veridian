generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogImagesStatus {
  IN_USE
  NOT_IN_USE
}

model BlogImage {
  id       String           @id @default(cuid())
  userId   Int
  publicId String
  url      String
  status   BlogImagesStatus @default(IN_USE)

  @@map("blog_images")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}
model Post {
  id String @id @default(cuid())
  title String
  slug String
  content String
  excerpt String
  coverImage String
  status BlogStatus @default(DRAFT)
  authorId Int
  publishedAt DateTime

  category Category[]
  tag Tag[]
  comment Comment[]
  like Like[]


  @@map("posts")

}

model Category {
  id String @id @default(cuid())
  name String
  slug String

  post Post[]

  @@map("categories")
}


model Tag {
id String @id @default(cuid())
name String
slug String @unique

post Post[]

@@map("tags")
}

model Comment{
  id String @id @default(cuid())
  content String
  parentId String?


  postId String
  post Post @relation(fields: [postId], references: [id])
  authorId Int
}

model Like {
  id String @id @default(cuid())
  userId Int

  postId String
  post Post @relation(fields: [postId], references: [id])
}
